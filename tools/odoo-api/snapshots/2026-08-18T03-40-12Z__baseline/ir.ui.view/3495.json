  "type": "qweb",
  "arch": "<data inherit_id=\"website.layout\" priority=\"30\">\n  <!-- Atlas header replaces the stock navbar — only when this page actually shows the standard header,\n       so pages that hide it (and render their own Atlas header in the page arch) get NO duplicate\n       #nav-toggle checkbox. -->\n  <xpath expr=\"//header[@id='top']//t[@t-call='website.navbar']\" position=\"replace\">\n    <t t-if=\"not ('header_visible' in main_object and not main_object.sudo().header_visible)\">\n      <link rel=\"stylesheet\" href=\"/web/content/3651\"/>\n      <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&amp;family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap\"/>\n      <t t-call=\"website.jka_header_v2\"/>\n      <div class=\"jk-appbar-spacer\" style=\"height:64px\"/>\n    </t>\n  </xpath>\n  <xpath expr=\"//header[@id='top']//t[@t-call='website.template_header_mobile']\" position=\"replace\"/>\n  <!-- Atlas footer, same guard -->\n  <xpath expr=\"//div[@id='footer']\" position=\"replace\">\n    <div id=\"footer\" t-if=\"not no_footer\">\n      <t t-if=\"not ('footer_visible' in main_object and not main_object.sudo().footer_visible)\">\n        <link rel=\"stylesheet\" href=\"/web/content/3651\"/>\n        <t t-call=\"website.jka_footer_v2\"/>\n      </t>\n    </div>\n  </xpath>\n  <xpath expr=\"//t[@t-call='web.brand_promotion']/..\" position=\"replace\"/>\n  <xpath expr=\"//footer//span[hasclass('o_footer_copyright_name')]\" position=\"replace\"/>\n</data>",
